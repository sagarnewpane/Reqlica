# Copy to .env in the repository root. These are the default server settings.
# Keep management interfaces on loopback; they have no authentication.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=3000
MOCK_HOST=127.0.0.1
MOCK_PORT=4000

# Optional app state directory. Default: ~/.reqlica
# REQLICA_HOME=/absolute/path/to/reqlica-home

# Optional Groq fallback key. Other provider keys are configured in web Settings.
# GROQ_API_KEY=

# Put project-specific secrets in Runtime > Environment, not here.
